# GembaTools — Environment Variables
# Copy this file to .env (gitignored) and fill in your values.

# ── Deploy / funding wallet ──────────────────────────────────────────────────
# Also the distributor for the audit live-fire: funds actor wallets + DEX liquidity.
# Needs ~5-10 Sepolia ETH for the full live-fire run.
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── Fee config (factory / swap router deploys) ───────────────────────────────
FEE_RECIPIENT=YOUR_ADDRESS
SWAP_FEE_RECIPIENT=YOUR_ADDRESS
SWAP_PLATFORM_FEE=30

# ── RPC URLs ─────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth/your_key
BSC_RPC_URL=https://rpc.ankr.com/bsc/your_key
POLYGON_RPC_URL=https://rpc.ankr.com/polygon/your_key
BASE_RPC_URL=https://rpc.ankr.com/base/your_key

# ── Block-explorer API keys (contract verification) ──────────────────────────
ETHERSCAN_API_KEY=your_etherscan_v2_key
BSCSCAN_API_KEY=your_bscscan_key
POLYGONSCAN_API_KEY=your_polygonscan_key
BASESCAN_API_KEY=your_basescan_key

# ── Audit suite: sweep targets ───────────────────────────────────────────────
# INTERIM (between test iterations): return all test ETH to the distributor
# wallet (= the address of DEPLOYER_PRIVATE_KEY) so it can be reused next run.
SWEEP_TO=0xdistributor_address_of_deployer_key
# FINAL (only after everything is fixed + the final test passes): sweep to the
# owner's collection wallet.
FINAL_SWEEP_TO=0xfinal_collection_address

# ── Audit suite: Uniswap V3 on Sepolia (DEX / GembaSwapRouter live-fire) ──────
# Local hardhat suite uses mocks; these are only for the Sepolia live-fire.
# Verify against the Uniswap docs before running.
UNISWAP_V3_ROUTER=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
WETH9=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
UNISWAP_V3_FACTORY=0x0227628f3F023bb0B980b67D528571c95c6DaC1c
NONFUNGIBLE_POSITION_MANAGER=0x1238536071E1c677A632429e3655c799b22cDA52
